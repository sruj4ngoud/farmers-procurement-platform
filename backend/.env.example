# Smart Farmer Procurement Platform — Backend Configuration
# Copy this file to .env and replace the placeholder values.
# NEVER commit .env to version control.

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://postgres:12345@localhost:5432/farmer_procurement

# JWT secret used to sign access tokens. MUST be provided in real deployments.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OTP settings. In demo/test mode the OTP is returned in the request-otp
# response so the farmer journey can be tested without a real SMS gateway.
OTP_DEMO_MODE=true
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
