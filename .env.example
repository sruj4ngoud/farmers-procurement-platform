# Smart Farmer Procurement Platform — Environment Configuration
# Copy this file to .env and replace the placeholder values.
# NEVER commit .env to version control.

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/farmer_procurement

# Used by docker-compose.yml (PostgreSQL service only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=farmer_procurement
POSTGRES_PORT=5432
